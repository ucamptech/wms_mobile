{
  "name": "wms-mobile-appium",
  "version": "1.0.0",
  "private": true,
  "description": "Appium tests for WMS Mobile",
  "scripts": {
    "test": "wdio run wdio.conf.js",
    "test:login": "wdio run wdio.conf.js --spec ./test/specs/login.spec.js",
    "test:home": "wdio run wdio.conf.js --spec ./test/specs/home.spec.js",
    "test:ops": "wdio run wdio.conf.js --spec ./test/specs/operations.spec.js",
    "test:full": "wdio run wdio.conf.js --spec ./test/specs/full_flow.spec.js"
  },
  "devDependencies": {
    "@wdio/appium-service": "^9.12.0",
    "@wdio/cli": "^9.12.0",
    "@wdio/local-runner": "^9.12.0",
    "@wdio/mocha-framework": "^9.12.0",
    "@wdio/spec-reporter": "^9.12.0",
    "appium": "^2.19.0",
    "appium-uiautomator2-driver": "^4.2.0"
  }
}
